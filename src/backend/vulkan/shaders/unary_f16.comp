/// @file unary_f16.comp
/// @brief GLSL compute shader for element-wise unary math operations (f16).
///
/// Loads fp16 from SSBO, computes in fp32, stores fp16 back.
/// Requires VK_KHR_16bit_storage with storageBuffer16BitAccess.
///
/// Specialization constants:
///   OP     = 0=Exp, 1=Log, 2=Sin, 3=Cos, 4=Tan, 5=Tanh, 6=Abs, 7=Neg, 8=Sqrt
///   ADD_TO = 0 (overwrite), 1 (accumulate)
///
/// Dispatch: ceil(total / 256) workgroups in X dimension.

#version 450
#extension GL_GOOGLE_include_directive : enable
#extension GL_EXT_shader_16bit_storage : require

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(constant_id = 0) const int OP = 0;
layout(constant_id = 1) const int ADD_TO = 0;

layout(set = 0, binding = 0) readonly buffer BufIn { float16_t in_data[]; };
layout(set = 0, binding = 1) buffer BufOut { float16_t out_data[]; };

layout(push_constant) uniform PushConstants {
    int total;
} pc;

void main() {
    int gid = int(gl_GlobalInvocationID.x);
    if (gid >= pc.total) return;

    float x = float(in_data[gid]);
    float result;

    if (OP == 0) {
        result = exp(x);
    } else if (OP == 1) {
        result = log(x);
    } else if (OP == 2) {
        result = sin(x);
    } else if (OP == 3) {
        result = cos(x);
    } else if (OP == 4) {
        result = tan(x);
    } else if (OP == 5) {
        result = tanh(x);
    } else if (OP == 6) {
        result = abs(x);
    } else if (OP == 7) {
        result = -x;
    } else {
        result = sqrt(x);
    }

    if (ADD_TO == 1) {
        out_data[gid] = float16_t(float(out_data[gid]) + result);
    } else {
        out_data[gid] = float16_t(result);
    }
}
